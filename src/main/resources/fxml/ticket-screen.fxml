<?xml version="1.0" encoding="UTF-8"?>

<?import com.autopay.parking.ui.util.IconView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autopay.parking.ui.controller.TicketScreenController"
      styleClass="screen" spacing="14" alignment="TOP_CENTER">
    <HBox fx:id="stepsBox" alignment="CENTER"/>

    <HBox alignment="CENTER" spacing="18">
        <StackPane fx:id="successIcon" styleClass="icon-stage-lg, icon-stage-success, icon-stage-md">
            <IconView icon="CHECK_CIRCLE" size="48"/>
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="4">
            <Label styleClass="title" text="Pago exitoso"/>
            <Label styleClass="subtitle" text="Gracias. Ya puede dirigirse a la salida con su vehículo."/>
        </VBox>
    </HBox>

    <HBox fx:id="receiptCard" styleClass="card" spacing="28" maxWidth="880" alignment="CENTER_LEFT">
        <!-- Comprobante -->
        <VBox fx:id="receiptColumn" spacing="14" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <IconView icon="TICKET" size="22"/>
                <Label styleClass="panel-title" text="Comprobante de pago"/>
            </HBox>
            <VBox styleClass="receipt" spacing="0">
                <HBox styleClass="receipt-row" alignment="CENTER_LEFT">
                    <Label styleClass="receipt-label" text="Ticket"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="ticketCodeLabel" styleClass="receipt-value" text="—"/>
                </HBox>
                <HBox styleClass="receipt-row" alignment="CENTER_LEFT">
                    <Label styleClass="receipt-label" text="Fecha y hora"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="paidAtLabel" styleClass="receipt-value" text="—"/>
                </HBox>
                <HBox styleClass="receipt-row" alignment="CENTER_LEFT">
                    <Label styleClass="receipt-label" text="Método de pago"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="methodLabel" styleClass="receipt-value" text="—"/>
                </HBox>
                <Separator styleClass="receipt-separator"/>
                <HBox styleClass="receipt-row, receipt-total" alignment="CENTER_LEFT">
                    <Label styleClass="receipt-total-label" text="Total pagado"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="amountLabel" styleClass="amount-mid, amount-accent" text="—"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- QR -->
        <VBox fx:id="qrPanel" styleClass="qr-panel" alignment="CENTER" spacing="8">
            <StackPane styleClass="qr-frame">
                <ImageView fx:id="qrImageView" fitWidth="180" fitHeight="180" preserveRatio="true"
                           smooth="false"/>
            </StackPane>
            <Label styleClass="form-label" text="Guarde su comprobante"/>
            <Label fx:id="qrHintLabel" styleClass="field-helper" wrapText="true"
                   maxWidth="200" minHeight="-Infinity" textAlignment="CENTER"/>
        </VBox>
    </HBox>

    <VBox alignment="CENTER" spacing="6">
        <Button fx:id="finishButton" styleClass="button-primary, button-lg, button-wide" text="Finalizar"
                onAction="#onNewTicket" defaultButton="true">
            <graphic>
                <IconView icon="HOME" size="22"/>
            </graphic>
        </Button>
        <Label fx:id="countdownLabel" styleClass="field-helper" text=""/>
    </VBox>
</VBox>
