<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.autopay.parking.ui.controller.TicketScreenController"
      styleClass="screen" spacing="24" alignment="CENTER">
    <HBox fx:id="stepsBox" alignment="CENTER"/>
    <HBox styleClass="success-badge" fx:id="successBadge" alignment="CENTER" spacing="12">
        <StackPane fx:id="successIconBox"/>
        <Label text="Pago exitoso"/>
    </HBox>
    <VBox styleClass="card" alignment="CENTER" spacing="12" maxWidth="700">
        <Label fx:id="ticketCodeLabel" styleClass="ticket-code" text="—"/>
        <Label fx:id="paidAtLabel" styleClass="detail-value" text="—"/>
        <HBox spacing="24" alignment="CENTER">
            <VBox styleClass="detail-box" alignment="CENTER" spacing="6">
                <Label styleClass="detail-label" text="Total pagado"/>
                <Label fx:id="amountLabel" styleClass="amount-mid" text="—"/>
            </VBox>
            <VBox styleClass="detail-box" alignment="CENTER" spacing="6">
                <Label styleClass="detail-label" text="Método"/>
                <Label fx:id="methodLabel" styleClass="detail-value" text="—"/>
            </VBox>
        </HBox>
        <HBox spacing="20" alignment="CENTER">
            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="qrImageView" fitWidth="280" fitHeight="280"
                           preserveRatio="true"/>
                <Label fx:id="qrHintLabel" styleClass="form-hint" wrapText="true"
                       maxWidth="360" textAlignment="CENTER"/>
            </VBox>
        </HBox>
        <Button styleClass="button-primary button-lg" text="Nuevo ticket"
                onAction="#onNewTicket"/>
    </VBox>
</VBox>
