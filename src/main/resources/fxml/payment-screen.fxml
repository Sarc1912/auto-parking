<?xml version="1.0" encoding="UTF-8"?>

<?import com.autopay.parking.ui.util.IconView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="paymentRoot" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autopay.parking.ui.controller.PaymentScreenController"
           alignment="TOP_CENTER">
    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="screen-scroll">
        <VBox spacing="20" alignment="TOP_CENTER" styleClass="screen">

            <HBox fx:id="stepsBox" alignment="CENTER"/>

            <!-- Resumen del ticket y monto, visible en todo el paso -->
            <HBox fx:id="amountBar" styleClass="amount-bar" alignment="CENTER_LEFT" spacing="16" maxWidth="880">
                <StackPane styleClass="icon-stage-sm">
                    <IconView icon="TICKET" size="22"/>
                </StackPane>
                <VBox spacing="2">
                    <Label styleClass="detail-label" text="Ticket"/>
                    <Label fx:id="ticketCodeLabel" styleClass="detail-value" text="—"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="0" alignment="CENTER_RIGHT">
                    <Label styleClass="detail-label" text="Total a pagar"/>
                    <Label fx:id="amountLabel" styleClass="amount-mid, amount-accent" text="—"/>
                    <Label fx:id="amountUsdLabel" styleClass="amount-usd" text="—"/>
                </VBox>
            </HBox>

            <!-- Selección de método -->
            <VBox fx:id="methodGridPane" spacing="16" maxWidth="880">
                <Label styleClass="section-title" text="¿Cómo desea pagar?"/>
                <GridPane fx:id="methodGrid" hgap="16" vgap="16">
                    <Button styleClass="method-card" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                            onAction="#onPagoMovilClicked" accessibleText="Pago Móvil"
                            GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <graphic>
                            <HBox styleClass="method-content" spacing="16" alignment="CENTER_LEFT">
                                <StackPane styleClass="method-icon-stage">
                                    <IconView icon="SMARTPHONE" size="30"/>
                                </StackPane>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="method-title" text="Pago Móvil"/>
                                    <Label styleClass="method-sub" text="Desde la app de su banco"/>
                                </VBox>
                                <IconView icon="CHEVRON_RIGHT" size="28" styleClass="method-chevron"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button styleClass="method-card" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                            onAction="#onCardPosClicked" accessibleText="Punto de Venta"
                            GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <graphic>
                            <HBox styleClass="method-content" spacing="16" alignment="CENTER_LEFT">
                                <StackPane styleClass="method-icon-stage">
                                    <IconView icon="CREDIT_CARD" size="30"/>
                                </StackPane>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="method-title" text="Punto de Venta"/>
                                    <Label styleClass="method-sub" text="Tarjeta de débito o crédito"/>
                                </VBox>
                                <IconView icon="CHEVRON_RIGHT" size="28" styleClass="method-chevron"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button styleClass="method-card" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                            onAction="#onCashVesClicked" accessibleText="Efectivo en bolívares"
                            GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <graphic>
                            <HBox styleClass="method-content" spacing="16" alignment="CENTER_LEFT">
                                <StackPane styleClass="method-icon-stage">
                                    <IconView icon="CURRENCY" size="30"/>
                                </StackPane>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="method-title" text="Efectivo Bs"/>
                                    <Label styleClass="method-sub" text="Billetes en bolívares"/>
                                </VBox>
                                <IconView icon="CHEVRON_RIGHT" size="28" styleClass="method-chevron"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button styleClass="method-card" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                            onAction="#onCashUsdClicked" accessibleText="Efectivo en dólares"
                            GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <graphic>
                            <HBox styleClass="method-content" spacing="16" alignment="CENTER_LEFT">
                                <StackPane styleClass="method-icon-stage">
                                    <IconView icon="BANKNOTE" size="30"/>
                                </StackPane>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label styleClass="method-title" text="Efectivo USD"/>
                                    <Label styleClass="method-sub" text="Billetes en dólares"/>
                                </VBox>
                                <IconView icon="CHEVRON_RIGHT" size="28" styleClass="method-chevron"/>
                            </HBox>
                        </graphic>
                    </Button>
                </GridPane>
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Button styleClass="button-secondary, button-lg" text="Volver" onAction="#onBackClicked"
                            cancelButton="true">
                        <graphic>
                            <IconView icon="ARROW_BACK" size="22"/>
                        </graphic>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox styleClass="hint-row" alignment="CENTER_RIGHT" spacing="8">
                        <IconView icon="INFO" size="18"/>
                        <Label styleClass="form-hint" text="Zelle y Binance Pay estarán disponibles próximamente"/>
                    </HBox>
                </HBox>
            </VBox>

            <!-- Formulario del método seleccionado -->
            <StackPane fx:id="methodFormPane" visible="false" managed="false" maxWidth="880">
                <VBox styleClass="card, form-card" spacing="18">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <StackPane fx:id="formIconBox" styleClass="icon-stage"/>
                        <VBox spacing="2">
                            <Label fx:id="formTitleLabel" styleClass="card-title" text="—"/>
                            <Label fx:id="formSubtitleLabel" styleClass="form-hint" text="—"/>
                            <Label fx:id="formTicketLabel" styleClass="field-helper" text="—"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="0">
                            <Label styleClass="detail-label" text="Monto a pagar"/>
                            <Label fx:id="formAmountLabel" styleClass="amount-mid, amount-accent" text="—"/>
                        </VBox>
                    </HBox>
                    <Separator/>
                    <VBox fx:id="formFieldsBox" spacing="12"/>

                    <HBox fx:id="paymentErrorBox" styleClass="alert, alert-error" alignment="CENTER_LEFT"
                          spacing="14" visible="false" managed="false">
                        <IconView icon="ERROR" size="28"/>
                        <VBox spacing="2">
                            <Label styleClass="alert-title" text="No se pudo procesar el pago"/>
                            <Label styleClass="alert-text" wrapText="true"
                                   text="No se realizó ningún cobro. Intente de nuevo o seleccione otro método."/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <HBox fx:id="validationHint" styleClass="hint-row" alignment="CENTER_LEFT" spacing="8"
                              HBox.hgrow="ALWAYS" minWidth="0">
                            <IconView icon="INFO" size="18"/>
                            <Label fx:id="validationHintLabel" styleClass="form-hint" wrapText="true"
                                   minHeight="-Infinity" text=""/>
                        </HBox>
                        <Button fx:id="changeMethodButton" styleClass="button-secondary, button-lg"
                                text="Cambiar método" onAction="#onCancelForm" minWidth="-Infinity">
                            <graphic>
                                <IconView icon="ARROW_BACK" size="22"/>
                            </graphic>
                        </Button>
                        <Button fx:id="confirmPaymentButton" styleClass="button-success, button-lg"
                                text="Confirmar pago" onAction="#onConfirmPayment" minWidth="-Infinity">
                            <graphic>
                                <IconView fx:id="confirmIcon" icon="CHECK" size="22"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <StackPane fx:id="processingBox" styleClass="processing-overlay" visible="false">
                    <VBox alignment="CENTER" spacing="14">
                        <ProgressIndicator prefWidth="64" prefHeight="64"/>
                        <Label styleClass="processing-title" text="Procesando pago…"/>
                        <Label styleClass="form-hint" text="Por favor espere, no cierre esta pantalla."/>
                    </VBox>
                </StackPane>
            </StackPane>
        </VBox>
    </ScrollPane>
</StackPane>
